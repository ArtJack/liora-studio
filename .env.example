# Liora Studio — environment template. Copy to .env and fill in. Never commit .env.

# libSQL / Turso database. For a local file DB use: file:./dev.db
DATABASE_URL="libsql://your-db.turso.io"
# Turso auth token (leave empty when using a local file: DATABASE_URL)
TURSO_AUTH_TOKEN=""

# Server-side secret for admin TOTP two-factor authentication (generate a random base32 secret)
TOTP_SECRET="REPLACE_WITH_RANDOM_BASE32_SECRET"

NODE_ENV="development"
